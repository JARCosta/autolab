# --- Telegram ---
TELEGRAM_NOTIFICATION_TOKEN=
TELEGRAM_LOGS_TOKEN=
TELEGRAM_USER_ID=
# Full HTTPS URL Telegram should POST to (e.g. https://your.domain/webhook behind nginx, Cloudflare Tunnel, etc.).
# If set, ngrok is not used; Telegram webhooks use this public HTTPS origin (required for Telegram over Tailscale-only).
TELEGRAM_WEBHOOK_PUBLIC_URL=

# --- Discord (BoostBot) ---
DISCORD_TOKEN=

# --- Ngrok (Telegram webhook tunnel only in this repo) ---
# StreamElements / Twitch IRC (autolab-bettors) connects out to Twitch; it does not use ngrok.
# Default 0: no ngrok (use LAN/Tailscale for the dashboard). Set 1 only if you need Telegram
# inbound webhooks and do not set TELEGRAM_WEBHOOK_PUBLIC_URL (requires NGROK_AUTH_TOKEN).
WEBAPP_ENABLE_NGROK=0
# Show Flask/Werkzeug request lines in logs (GET/POST ... 200).
WEBAPP_SHOW_ACCESS_LOGS=1
# Bind host/port for Flask webapp (0.0.0.0 allows LAN access).
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=5000
# Optional dedicated inbound gateway bind (autolab-inbound service). Falls back to WEBAPP_HOST/WEBAPP_PORT.
INBOUND_HOST=0.0.0.0
INBOUND_PORT=5000
NGROK_AUTH_TOKEN=
# Optional: required for some features (e.g. internal endpoints); create in ngrok dashboard.
NGROK_API_KEY=
# Cloud Endpoint public URL (fixed). Use when traffic policy forward-internal targets an internal agent.
NGROK_PUBLIC_URL=
# Internal hostname for the agent; must match forward-internal config.url host (e.g. default.internal).
NGROK_INTERNAL_DOMAIN=

# --- Hardware monitor (optional) ---
# Friendly device label for this server (same .env is loaded in Docker via env_file).
# If unset: Windows COMPUTERNAME, else kernel hostname (in Docker often the container id).
HARDWARE_DEVICE_NAME=
# Shared secret used by hardware push + pull endpoints.
HARDWARE_TOKEN=
# Nodes self-register on startup. Optional static override (same format as before):
# HARDWARE_PULL_NODES: device→base URL map, e.g. gaming-pc=http://192.168.1.22:8765
HARDWARE_PULL_NODES=
# Legacy: HARDWARE_PULL_CLIENTS (still read if HARDWARE_PULL_NODES is empty)

# --- Continente tracker (optional) ---
# Comma-separated authenticated JSON endpoints to scan.
CONTINENTE_ENDPOINTS=https://www.continente.pt/on/demandware.store/Sites-continente-Site/default/Cart-GetCustomerBenefits
# Browser-like headers (keep secrets only in .env, never commit).
CONTINENTE_USER_AGENT=
CONTINENTE_COOKIE=
# Optional JSON object for additional headers, e.g. {"referer":"https://www.continente.pt/conta/cartao-continente/"}
CONTINENTE_EXTRA_HEADERS_JSON=
# Polling interval in seconds (min 60).
CONTINENTE_POLL_SECONDS=1800

# --- Faceit ---
FACEIT_API_KEY=

# --- Tailscale ---
# Managed externally (Tailscale admin/client). autolab-tailscale runs as infra service.
